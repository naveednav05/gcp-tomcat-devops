pipeline {

    agent any

    options {
        disableConcurrentBuilds()
        timestamps()
        skipDefaultCheckout(true)
    }

    stages {

        /*
         * ============================================================
         * 1. VALIDATE HANDOFF NUMBER
         * ============================================================
         */
        stage('Validate Handoff') {
            steps {
                script {

                    if (!params.HANDOFF_NUMBER) {
                        error(
                            "HANDOFF_NUMBER was not provided."
                        )
                    }

                    def handoff = params.HANDOFF_NUMBER.trim()

                    if (!(handoff ==~ /^hf-[0-9]{4}$/)) {
                        error(
                            "Invalid handoff number: '${handoff}'. " +
                            "Expected format: hf-0000. Example: hf-0098"
                        )
                    }

                    echo "=============================================="
                    echo "JOB 2 - DOCKER IMAGE BUILD"
                    echo "=============================================="
                    echo "Handoff Number : ${handoff}"
                    echo "Replace Image  : ${params.REPLACE_IMAGE}"
                    echo "=============================================="
                }
            }
        }


        /*
         * ============================================================
         * 2. CHECK WAR ARTIFACT
         * ============================================================
         */
        stage('Check WAR Artifact') {
            steps {
                script {

                    def handoff = params.HANDOFF_NUMBER.trim()

                    echo "Checking Artifact Registry..."
                    echo "Requested handoff: ${handoff}"

                    def output = sh(
                        script: '''
                            gcloud artifacts versions list \
                              --project=gcp-gke-12345 \
                              --location=asia-south1 \
                              --repository=war-files \
                              --package=myapp \
                              --format="value(name.basename())"
                        ''',
                        returnStdout: true
                    ).trim()

                    def availableVersions =
                        output ? output.readLines() : []

                    echo ""
                    echo "Available handoff versions:"
                    echo "----------------------------------------------"

                    if (availableVersions) {

                        availableVersions.each {
                            echo "  ${it}"
                        }

                    } else {

                        echo "  No versions found."
                    }

                    echo "----------------------------------------------"

                    if (!availableVersions.contains(handoff)) {

                        error(
                            "WAR artifact for handoff '${handoff}' " +
                            "was not found in Artifact Registry."
                        )
                    }

                    echo "✅ Handoff '${handoff}' exists."
                }
            }
        }


        /*
         * ============================================================
         * 3. CHECK EXISTING DOCKER IMAGE
         * ============================================================
         */
        stage('Check Existing Docker Image') {
            steps {
                script {

                    def handoff = params.HANDOFF_NUMBER.trim()

                    def imageName =
                        "asia-south1-docker.pkg.dev/gcp-gke-12345/application/myapp:${handoff}"

                    echo "=============================================="
                    echo "Checking Existing Docker Image"
                    echo "=============================================="
                    echo "Image: ${imageName}"

                    def imageExists = sh(
                        script: """
                            if gcloud artifacts docker images describe \
                              '${imageName}' \
                              --project=gcp-gke-12345 \
                              >/dev/null 2>&1
                            then
                                echo "true"
                            else
                                echo "false"
                            fi
                        """,
                        returnStdout: true
                    ).trim()

                    if (imageExists == "true") {

                        echo ""
                        echo "⚠️ Docker image already exists."
                        echo "Handoff : ${handoff}"
                        echo "Replace : ${params.REPLACE_IMAGE}"

                        if (!params.REPLACE_IMAGE) {

                            error(
                                "Docker image '${imageName}' already exists. " +
                                "REPLACE_IMAGE is false. " +
                                "Enable REPLACE_IMAGE to replace it."
                            )
                        }

                        echo ""
                        echo "⚠️ REPLACE_IMAGE=true"
                        echo "Existing image will be replaced."
                        echo "Continuing with Docker build..."

                    } else {

                        echo ""
                        echo "✅ Docker image does not exist."
                        echo "New image will be created."
                    }
                }
            }
        }


        /*
         * ============================================================
         * 4. CHECKOUT ONLY JOB-2
         * ============================================================
         */
        stage('Checkout Dockerfile') {
            steps {

                checkout([
                    $class: 'GitSCM',

                    branches: [[
                        name: '*/PROD'
                    ]],

                    userRemoteConfigs: [[
                        url: 'https://github.com/naveednav05/gcp-tomcat-devops.git',
                        credentialsId: 'github-gcp-tomcat'
                    ]],

                    extensions: [

                        [
                            $class: 'SparseCheckoutPaths',

                            sparseCheckoutPaths: [[
                                path: 'job-2/'
                            ]]
                        ],

                        [
                            $class: 'CleanBeforeCheckout'
                        ]
                    ]
                ])

                sh '''
                    echo "=============================================="
                    echo "Validating Git Checkout"
                    echo "=============================================="

                    if [ ! -f job-2/Dockerfile ]; then
                        echo "ERROR: job-2/Dockerfile not found."
                        exit 1
                    fi

                    echo "✅ Dockerfile found."

                    echo ""
                    echo "Checked out files:"
                    find job-2 -maxdepth 2 -type f -print
                '''
            }
        }


        /*
         * ============================================================
         * 5. DOWNLOAD WAR
         * ============================================================
         */
        stage('Download WAR') {
            steps {
                script {

                    def handoff = params.HANDOFF_NUMBER.trim()

                    sh '''
                        rm -rf build-context
                        mkdir -p build-context
                    '''

                    sh """
                        echo "=============================================="
                        echo "Downloading WAR"
                        echo "=============================================="

                        gcloud artifacts generic download \
                          --project=gcp-gke-12345 \
                          --location=asia-south1 \
                          --repository=war-files \
                          --package=myapp \
                          --version='${handoff}' \
                          --name=myapp.war \
                          --destination="\$PWD/build-context"
                    """

                    sh '''
                        if [ ! -f build-context/myapp.war ]; then
                            echo "ERROR: myapp.war was not downloaded."
                            exit 1
                        fi

                        echo ""
                        echo "Downloaded WAR:"
                        ls -lh build-context/myapp.war

                        echo ""
                        echo "WAR SHA256:"
                        sha256sum build-context/myapp.war
                    '''
                }
            }
        }


        /*
         * ============================================================
         * 6. PREPARE DOCKER BUILD CONTEXT
         * ============================================================
         */
        stage('Prepare Docker Build Context') {
            steps {

                sh '''
                    echo "=============================================="
                    echo "Preparing Docker Build Context"
                    echo "=============================================="

                    cp job-2/Dockerfile build-context/Dockerfile

                    echo ""
                    echo "Build context:"
                    ls -lh build-context/

                    echo ""
                    echo "Dockerfile:"
                    cat build-context/Dockerfile
                '''
            }
        }


        /*
         * ============================================================
         * 7. VALIDATE DOCKER BUILD CONTEXT
         * ============================================================
         */
        stage('Validate Docker Build Context') {
            steps {

                sh '''
                    echo "=============================================="
                    echo "Validating Docker Build Context"
                    echo "=============================================="

                    test -f build-context/Dockerfile
                    test -f build-context/myapp.war

                    echo "✅ Dockerfile exists."
                    echo "✅ WAR file exists."

                    echo ""
                    echo "Files to be used for Docker build:"
                    ls -lh build-context/
                '''
            }
        }


        /*
         * ============================================================
         * 8. AUTHENTICATE DOCKER
         * ============================================================
         */
        stage('Authenticate Docker') {
            steps {

                sh '''
                    echo "=============================================="
                    echo "Configuring Docker Authentication"
                    echo "=============================================="

                    gcloud auth configure-docker \
                      asia-south1-docker.pkg.dev \
                      --quiet
                '''
            }
        }


        /*
         * ============================================================
         * 9. PULL PRIVATE TOMCAT BASE IMAGE
         * ============================================================
         */
        stage('Pull Tomcat Base Image') {
            steps {

                sh '''
                    echo "=============================================="
                    echo "Pulling Tomcat Base Image"
                    echo "=============================================="

                    docker pull \
                      asia-south1-docker.pkg.dev/gcp-gke-12345/tomcat-base/tomcat:v1
                '''
            }
        }


        /*
         * ============================================================
         * 10. BUILD FINAL APPLICATION IMAGE
         * ============================================================
         */
        stage('Build Docker Image') {
            steps {
                script {

                    def handoff = params.HANDOFF_NUMBER.trim()

                    sh """
                        echo "=============================================="
                        echo "Building Docker Image"
                        echo "=============================================="

                        docker build \
                          --pull=false \
                          -t asia-south1-docker.pkg.dev/gcp-gke-12345/application/myapp:${handoff} \
                          build-context

                        echo ""
                        echo "✅ Docker image built successfully."
                    """
                }
            }
        }


        /*
         * ============================================================
         * 11. INSPECT IMAGE
         * ============================================================
         */
        stage('Inspect Docker Image') {
            steps {
                script {

                    def handoff = params.HANDOFF_NUMBER.trim()

                    sh """
                        echo "=============================================="
                        echo "Docker Image Details"
                        echo "=============================================="

                        docker image inspect \
                          asia-south1-docker.pkg.dev/gcp-gke-12345/application/myapp:${handoff} \
                          --format='Image ID: {{.Id}}'

                        docker image inspect \
                          asia-south1-docker.pkg.dev/gcp-gke-12345/application/myapp:${handoff} \
                          --format='Created: {{.Created}}'

                        docker image inspect \
                          asia-south1-docker.pkg.dev/gcp-gke-12345/application/myapp:${handoff} \
                          --format='Entrypoint: {{json .Config.Entrypoint}}'

                        docker image inspect \
                          asia-south1-docker.pkg.dev/gcp-gke-12345/application/myapp:${handoff} \
                          --format='Cmd: {{json .Config.Cmd}}'
                    """
                }
            }
        }


        /*
         * ============================================================
         * 12. PUSH IMAGE
         * ============================================================
         */
        stage('Push Docker Image') {
            steps {
                script {

                    def handoff = params.HANDOFF_NUMBER.trim()

                    sh """
                        echo "=============================================="
                        echo "Pushing Docker Image"
                        echo "=============================================="

                        docker push \
                          asia-south1-docker.pkg.dev/gcp-gke-12345/application/myapp:${handoff}

                        echo ""
                        echo "✅ Docker push completed."
                    """
                }
            }
        }


        /*
         * ============================================================
         * 13. VERIFY IMAGE IN ARTIFACT REGISTRY
         * ============================================================
         */
        stage('Verify Docker Image') {
            steps {
                script {

                    def handoff = params.HANDOFF_NUMBER.trim()

                    def image = sh(
                        script: """
                            gcloud artifacts docker images describe \
                              asia-south1-docker.pkg.dev/gcp-gke-12345/application/myapp:${handoff} \
                              --project=gcp-gke-12345 \
                              --format="value(image_summary.digest)"
                        """,
                        returnStdout: true
                    ).trim()

                    if (!image) {

                        error(
                            "Docker image verification failed. " +
                            "Image '${handoff}' was not found in Artifact Registry."
                        )
                    }

                    echo ""
                    echo "=============================================="
                    echo "DOCKER IMAGE VERIFIED"
                    echo "=============================================="
                    echo "Tag    : ${handoff}"
                    echo "Digest : ${image}"
                    echo "=============================================="
                }
            }
        }
    }


    /*
     * ================================================================
     * POST ACTIONS
     * ================================================================
     */
    post {

        success {
            script {

                def handoff = params.HANDOFF_NUMBER.trim()

                echo ""
                echo "=============================================="
                echo "🎉 JOB 2 SUCCESS"
                echo "=============================================="
                echo ""
                echo "Handoff Number:"
                echo "${handoff}"
                echo ""
                echo "Docker Image:"
                echo "asia-south1-docker.pkg.dev/gcp-gke-12345/application/myapp:${handoff}"
                echo ""
                echo "Status: SUCCESS"
                echo "=============================================="
            }
        }


        failure {

            echo ""
            echo "=============================================="
            echo "❌ JOB 2 FAILED"
            echo "=============================================="
            echo "Check the failed stage above."
            echo "=============================================="
        }


        always {

            sh '''
                echo "=============================================="
                echo "Jenkins Workspace Cleanup"
                echo "=============================================="

                rm -rf build-context || true

                echo "Temporary Docker build context removed."
            '''
        }
    }
}
